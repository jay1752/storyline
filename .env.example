# Copy to .env and fill in whichever sources you actually want live.
# Empty/missing values are fine — those sources just report "not configured" in /admin
# instead of failing silently. Nothing here is required to run the app on mock data.

# SEC EDGAR — free, no signup, but SEC requires a descriptive User-Agent identifying
# your app + a contact email, or it blocks requests. https://www.sec.gov/os/webmaster-faq#code-support
SEC_EDGAR_USER_AGENT=Storyline you@example.com

# Tiingo — US daily OHLC prices. Free-tier signup, no KYC. https://www.tiingo.com
TIINGO_API_KEY=

# Finnhub — "guidance vs. delivered" (EPS beat/met/miss), US only. Free-tier signup,
# no KYC, 60 calls/min. Free tier covers the last 4 quarters. https://finnhub.io
FINNHUB_API_KEY=

# 5paisa — India price/OHLC. Official Vendor API (Openapi.5paisa.com), TOTP-based login,
# fully automated (no daily manual step, unlike Kite below). Get these from
# xstream.5paisa.com/dashboard — needs a 5paisa trading account + KYC.
# Only these 6 are used; PASSWORD/APP_NAME/APP_SOURCE are NOT needed (confirmed against
# the SDK source) — do not add them here, no reason to hold credentials this app never uses.
FIVEPAISA_CLIENT_ID=
FIVEPAISA_MPIN=
FIVEPAISA_TOTP_SECRET=
FIVEPAISA_USER_KEY=
FIVEPAISA_USER_ID=
FIVEPAISA_ENCRYPTION_KEY=

# Kite Connect (Zerodha) — India price/OHLC, fallback behind 5paisa. Needs a Zerodha
# account + a registered Kite Connect app (https://developers.kite.trade) for API_KEY/SECRET.
# ACCESS_TOKEN expires daily — mint a fresh one with: python -m scripts.kite_login
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# FRED (St. Louis Fed) — US macro context (Layer 5): Fed funds rate, CPI inflation,
# GDP growth, unemployment. Free-tier signup, email only, instant, no approval.
# https://fredaccount.stlouisfed.org
FRED_API_KEY=

# Gemini — AI chat + daily Insights, platform-default provider. Free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (the model on this shared key is fixed in code: gemini-3.1-flash-lite)

# Anthropic (Claude) — AI chat + daily Insights, BYOK-only (no platform-funded
# default). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# App master key — encrypts a user's own BYOK LLM key at rest in users.db (Fernet).
# Generate once with: python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Changing this after a key has been saved makes that saved key undecryptable.
APP_MASTER_KEY=

# Resend — sends verification/password-reset emails. Free key at https://resend.com.
# Left empty, signup/login/reset still work — the link is just logged to stdout instead
# of emailed. See app/auth/email.py.
RESEND_API_KEY=
RESEND_FROM=Storyline <onboarding@resend.dev>

# Base URL used to build verification/reset links.
APP_BASE_URL=http://localhost:8000

# Set to "true" only when served over real HTTPS.
COOKIE_SECURE=false
